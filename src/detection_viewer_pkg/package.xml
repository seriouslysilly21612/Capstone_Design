<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>detection_viewer_pkg</name>
  <version>0.0.0</version>
  <description>Desktop-side bbox overlay viewer for the KV260 perception pipeline.
  Runs on a desktop, not the board: subscribes to the board's compressed color
  stream + /detections, joins by header stamp, and draws the boxes locally.</description>
  <maintainer email="kww642@mju.ac.kr">ubuntu</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>my_interfaces</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
